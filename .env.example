# Server-only. Never prefix secrets with NEXT_PUBLIC_.
# Active conversation and catalog use Channel3's hosted agent; Ollama is not required.
CHANNEL3_API_KEY=
# Optional separate $1 Sandbox demo. Use a distinct Sandbox personal buyer.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
# Single server, private persistent storage; includes shopping messages/payment IDs.
DATA_DIR=.data
