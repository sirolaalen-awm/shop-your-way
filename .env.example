# Server only. Never prefix secrets with NEXT_PUBLIC_.
AI_PROVIDER=ollama
AI_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# For hosted AI instead, set AI_PROVIDER=openai and AI_MODEL explicitly.
OPENAI_API_KEY=
CHANNEL3_API_KEY=
# Use only a Sandbox REST app and a DIFFERENT Sandbox personal buyer account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must match the browser origin when deployed (https required outside localhost).
APP_ORIGIN=http://127.0.0.1:3000
# Single server, persistent local volume. Session files contain conversation data.
DATA_DIR=.data
